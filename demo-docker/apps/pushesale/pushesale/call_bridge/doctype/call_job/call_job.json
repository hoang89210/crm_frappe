   "report": 1,
   "share": 1,
   "write": 1
  },
  {
   "role": "Sales Manager",
   "email": 1,
   "print": 1,
   "read": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "Sales User",
   "create": 1,
   "email": 1,
   "print": 1,
   "read": 1,
   "report": 1,
   "write": 1
  }
 ],
