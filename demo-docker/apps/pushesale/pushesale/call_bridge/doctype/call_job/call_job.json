{
 "doctype": "DocType",
 "name": "Call Job",
 "module": "Call Bridge",
 "autoname": "naming_series:",
 "allow_import": 1,
 "field_order": [
  "naming_series",
  "lead",
  "phone",
  "device",
  "status",
  "column_break_1",
  "created_by_user",
  "expires_on",
  "call_log"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "CALL-JOB-.YYYY.-",
