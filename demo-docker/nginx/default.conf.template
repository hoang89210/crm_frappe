# Template: the nginx image renders this with envsubst into
# /etc/nginx/conf.d/default.conf. Only env vars that are set (SITE_NAME) are
# substituted; nginx variables like $host stay untouched.

upstream frappe_backend {
    server backend:8000;
}

upstream chatwoot_web {
    server chatwoot:3000;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 50m;

    # Chatwoot static (Vite) - absolute paths from CW HTML
    location /vite/ {
        proxy_pass http://chatwoot_web/vite/;
        proxy_set_header Host $host;
    }

    location /chatwoot/ {
        proxy_pass http://chatwoot_web/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect / /chatwoot/;
        proxy_redirect http://$host/ /chatwoot/;
        proxy_cookie_path / /chatwoot/;
        proxy_read_timeout 120s;
        proxy_set_header Accept-Encoding "";
        # Fix absolute asset paths in HTML (sub_filter applies to text/html by default)
        sub_filter 'href="/vite/' 'href="/vite/';
        sub_filter 'src="/vite/' 'src="/vite/';
        sub_filter 'href="/installation/' 'href="/chatwoot/installation/';
        sub_filter 'href="/app/' 'href="/chatwoot/app/';
        sub_filter 'href="/super_admin/' 'href="/chatwoot/super_admin/';
        sub_filter 'href="/auth/' 'href="/chatwoot/auth/';
        sub_filter_once off;
    }

    location = /chatwoot {
        return 301 /chatwoot/;
    }

    # Chatwoot API (avoid clash with Frappe /api/method)
    location /api/v1/ {
        proxy_pass http://chatwoot_web/api/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://frappe_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Frappe-Site-Name ${SITE_NAME};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
}
