# Copy to .env and edit before deploy

# Frappe
DB_ROOT_PASSWORD=change-me-strong-db-root
ADMIN_PASSWORD=admin
SITE_NAME=crm.local

# Public URL used by browser (no trailing slash). Example: http://203.0.113.10
PUBLIC_BASE_URL=http://127.0.0.1

# Chatwoot
CHATWOOT_DB_PASSWORD=chatwoot-change-me
# Generate with: openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=please_replace_with_openssl_rand_hex_64_characters_minimum_length_value_here_ok
