# Copy to .env and edit before deploy

# Frappe
DB_ROOT_PASSWORD=change-me-strong-db-root
ADMIN_PASSWORD=admin
SITE_NAME=crm.local

# Public URL used by browser (no trailing slash). Example: http://203.0.113.10
PUBLIC_BASE_URL=http://127.0.0.1

# Chatwoot
CHATWOOT_DB_PASSWORD=chatwoot-change-me
# Generate with: openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=please_replace_with_openssl_rand_hex_64_characters_minimum_length_value_here_ok

# --- Backend boot behaviour (optional; defaults shown) ---
# 1 = if the site is PROVABLY half-created (no sites/<site>/.provisioned marker,
#     Core tables missing/empty, no user data) drop it and run new-site again.
#     A site that may hold data is never dropped: the container exits with an error.
#     Set 0 to always stop and recover by hand instead.
AUTO_RECREATE_BROKEN_SITE=1
# 1 = bench serve (Werkzeug dev server WITH interactive debugger). Local dev only!
FRAPPE_DEV_SERVER=0
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
